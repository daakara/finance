# Environment Variables for ARX Terminal
# Copy this file to .env and configure for your local/staging/production deployment.

# 1. API Security & Authentication Key
# Secret key validated via X-API-Key header. Must match NEXT_PUBLIC_ARX_API_KEY on the frontend.
ARX_API_KEY=your_arx_api_secret_key_here

# 2. Environment Mode
# Set to 'production' on live hosts (masks internal 500 tracebacks and disables Swagger /docs)
ENVIRONMENT=development

# 3. Distributed Redis Rate Limiter (Optional)
# If omitted or unavailable, backend automatically falls back to in-memory sliding window
REDIS_URL=redis://localhost:6379/0

# 4. Macro & Fundamental Data Pipeline Providers (Optional)
# Federal Reserve Economic Data (FRED) API Key for real-time yield curves, fed funds, CPI
FRED_API_KEY=your_fred_api_key_here

# EODHD API Key for institutional realtime quotes and alternate candlestick failover
EODHD_API_KEY=your_eodhd_api_key_here

# 5. CORS Configuration (Optional)
# Additional single allowed origin (e.g. preview deployment URL)
ALLOWED_ORIGIN=https://finance-xp8.pages.dev

# 6. Logging Configuration
LOG_LEVEL=INFO


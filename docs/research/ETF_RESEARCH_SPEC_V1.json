  "feature_definitions": {
    "f1_trend_ratio": {
      "formula": "(Close_t - SMA(Close, period=200, t)) / ATR(period=20, t)",
      "inputs": [
        "Close",
        "High",
        "Low"
      ],
      "lookback_sessions": 200,
      "parameters": {
        "sma_period": 200,
        "atr_period": 20
      },
      "expected_sign": "POSITIVE",
      "hypothesis_id": "H1_trend_ratio"
    },
    "f2_relative_strength_60d": {
      "formula": "(Close_t / Close_{t-60}) - (SPY_t / SPY_{t-60})",
      "inputs": [
        "Close",
        "SPY_Close"
      ],
      "lookback_sessions": 60,
      "parameters": {
        "momentum_period": 60
      },
      "expected_sign": "POSITIVE",
      "hypothesis_id": "H2_relative_strength_60d"
    },
    "f3_rsi_regime_distance": {
      "formula": "exp( - ((RSI(Close, period=14, t) - 60.0)^2) / (2 * (15.0)^2) )",
      "inputs": [
        "Close"
      ],
      "lookback_sessions": 28,
      "parameters": {
        "rsi_period": 14,
        "regime_center": 60.0,
        "regime_width": 15.0
      },
      "expected_sign": "POSITIVE",
      "hypothesis_id": "H3_rsi_regime_distance"
    },
    "f4_vol_compression": {
      "formula": "ATR(period=10, t) / ATR(period=50, t)",
      "inputs": [
        "High",
        "Low",
        "Close"
      ],
      "lookback_sessions": 50,
      "parameters": {
        "short_atr_period": 10,
        "long_atr_period": 50
      },
      "expected_sign": "EXPLORATORY_ONLY (Excluded from directional confirmatory models)"
    },
    "f5_yield_curve_slope": {
      "formula": "FRED_T10Y2Y_t",
      "inputs": [
        "T10Y2Y"
      ],
      "lookback_sessions": 1,
      "parameters": {
        "lag": 0
      },
      "expected_sign": "POSITIVE",
      "hypothesis_id": "H5_yield_curve_slope"
    },
    "f6_rate_momentum_20d": {
      "formula": "FRED_DGS10_t - FRED_DGS10_{t-20}",
      "inputs": [
        "DGS10"
      ],
      "lookback_sessions": 20,
      "parameters": {
        "delta_period": 20
      },
      "expected_sign": "NEGATIVE",
      "hypothesis_id": "H6_rate_momentum_20d"
    },
    "f7_credit_spread_trend": {
      "status": "DEPRECATED_IN_V1_0_2",
      "original_source": "BAMLH0A0HYM2",
      "original_concept": "US HIGH-YIELD OPTION-ADJUSTED SPREAD TREND",
      "deprecation_reason": "FRED HOSTED BAMLH0A0HYM2 LIMITED TO THREE YEARS STARTING APRIL 2026; OLDER HISTORY NOT ASSUMED AVAILABLE FOR THIS RESEARCH PIPELINE",
      "formula": "FRED_BAMLH0A0HYM2_t - FRED_BAMLH0A0HYM2_{t-20}",
      "inputs": [
        "BAMLH0A0HYM2"
      ],
      "lookback_sessions": 20,
      "parameters": {
        "delta_period": 20
      },
      "expected_sign": "NEGATIVE",
      "public_source_limitation": {
        "limitation_statement": "FRED HOSTED BAMLH0A0HYM2 LIMITED TO THREE YEARS STARTING APRIL 2026",
        "older_history_existence": "MAY EXIST FROM UNDERLYING SOURCE (ICE Benchmark Administration / ICE Data Indices)",
        "older_history_license_and_access": "NOT ASSUMED AVAILABLE FOR THIS RESEARCH PIPELINE"
      }
    },
    "f8_relative_strength_vs_lqd": {
      "formula": "(HYG_t / HYG_{t-60}) - (LQD_t / LQD_{t-60})",
      "inputs": [
        "HYG_Close",
        "LQD_Close"
      ],
      "lookback_sessions": 60,
      "parameters": {
        "momentum_period": 60
      },
      "expected_sign": "POSITIVE",
      "hypothesis_id": "H8_relative_strength_vs_lqd"
    },
    "f9_real_yield_regime": {
      "formula": "FRED_DFII10_t - FRED_DFII10_{t-20}",
      "inputs": [
        "DFII10"
      ],
      "lookback_sessions": 20,
      "parameters": {
        "delta_period": 20
      },
      "expected_sign": "NEGATIVE",
      "hypothesis_id": "H9_real_yield_regime"
    },
    "f10_dxy_trend": {
      "formula": "(UUP_t - SMA(UUP, period=50, t)) / ATR(UUP, period=20, t)",
      "inputs": [
        "UUP_Close",
        "UUP_High",
        "UUP_Low"
      ],
      "lookback_sessions": 50,
      "parameters": {
        "sma_period": 50,
        "atr_period": 20
      },
      "expected_sign": "NEGATIVE",
      "hypothesis_id": "H10_dxy_trend"
    },
    "f11_bullion_breakout": {
      "formula": "(Close_t - min_{k=0..49}(Low_{t-k})) / (max_{k=0..49}(High_{t-k}) - min_{k=0..49}(Low_{t-k}))",
      "inputs": [
        "Close",
        "High",
        "Low"
      ],
      "lookback_sessions": 50,
      "parameters": {
        "breakout_period": 50
      },
      "expected_sign": "POSITIVE",
      "hypothesis_id": "H11_bullion_breakout"
    },
    "f12_baa_corporate_spread_trend": {
      "status": "PREREGISTERED_CONFIRMATORY_CANDIDATE",
      "source": "FRED BAA10Y",
      "economic_concept": "Moody's Seasoned Baa Corporate Bond Yield Relative to 10-Year Treasury Constant Maturity 20-day trend. Measures investment-grade corporate credit spread momentum over Treasuries.",
      "is_high_yield_oas": false,
      "is_semantically_equivalent_to_f7": false,
      "formula": "FRED_BAA10Y_available_at_t - FRED_BAA10Y_available_at_{t-20}",
      "inputs": [
        "BAA10Y"
      ],
      "lookback_sessions": 20,
      "parameters": {
        "delta_period": 20,
        "macro_lag": "LAGGED_KNOWABLE_INFORMATION (t-1)",
        "missing_date_policy": "FORWARD_FILL_LAST_KNOWN_PUBLISHED_VALUE_MAX_5D"
      },
      "units": "PERCENTAGE_POINTS",
      "expected_sign": "NEGATIVE",
      "session_alignment_semantics": {
        "observation_calendar": "ETF_PRIMARY_TRADING_SESSION_CALENDAR",
        "value_at_session_t": "LATEST BAA10Y OBSERVATION KNOWABLE BEFORE THE SPECIFIED SESSION CUTOFF (t-1)",
        "lookback_sessions": 20,
        "lookback_nature": "20 ETF TRADING SESSIONS (EXPLICITLY NOT 20 CALENDAR DAYS AND NOT 20 ARBITRARY FRED ROWS)",
        "release_lag": "CONSERVATIVE t-1 KNOWABILITY RULE",
        "forward_fill": "MAX 5 ETF TRADING SESSIONS",
        "gap_gt_5_sessions_policy": "FAIL_CLOSED (Evaluates to NULL / NaN; observation dropped from confirmatory matrix)"
      },
      "hypothesis_id": "H12_baa_corporate_spread_trend"
    }
  },
  "feature_preprocessing": {
    "missing_value_handling": "FAIL_CLOSED (Observation dropped if any required subtype feature evaluates to null/NaN)",
    "winsorization": {
      "policy": "WINSORIZE_AT_PERCENTILES",
      "lower_percentile": 0.01,
      "upper_percentile": 0.99,
      "estimation_scope": "TRAINING_PARTITION_ONLY"
    },
    "standardization": {
      "policy": "Z_SCORE_STANDARDIZATION",
      "formula": "z = (x - mean_train) / std_train",
      "estimation_scope": "TRAINING_PARTITION_ONLY (Frozen scaler applied out-of-sample to validation/holdout)"
    },
    "direction_alignment": {
      "policy": "ALIGN_TO_POSITIVE_HYPOTHESIS",
      "formula": "x_aligned = x_standardized * sign_expected",
      "description": "Features with negative expected sign are inverted so all hypothesized regression coefficients are strictly positive"
    }
  },
  "target_preprocessing": {
    "model_training_target": "WINSORIZED_BENCHMARK_RELATIVE_EXCESS_RETURN",
    "training_target_winsorization": "1st and 99th percentiles fit on training fold only",
    "ic_evaluation_target": "RAW_BENCHMARK_RELATIVE_EXCESS_RETURN (Rank IC is invariant to monotonic scaling; un-winsorized)"
  },

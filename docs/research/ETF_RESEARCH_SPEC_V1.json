  "primary_model_family": {
    "estimator_name": "RIDGE_REGRESSION_TOWARD_EQUAL_WEIGHT_PRIOR",
    "objective_loss_function": "argmin_w (1 / (2*N)) * ||Y - X w||_2^2 + (lambda / 2) * ||w - w_prior||_2^2",
    "estimator_formula": "w_hat = (X^T X + N * lambda * I)^{-1} (X^T Y + N * lambda * w_prior)",
    "prior_vector": "w_prior = (1 / K) * 1_K",
    "direction_alignment": "Features pre-aligned by expected sign; coefficients opposite prior indicate hypothesis weakness",
    "sensitivity_alternative": "NON_NEGATIVE_LEAST_SQUARES_NNLS"
  },
  "baseline_models": [

    "confirmation_policy": {
      "SUPPORTED": "Point estimate matches expected sign AND p-value <= 0.05 under primary two-way clustered covariance",
      "FALSIFIED": "Point estimate has opposite sign AND p-value <= 0.05 under primary two-way clustered covariance",
      "INCONCLUSIVE": "p-value > 0.05 under primary two-way clustered covariance"
    },

{
  "policy_name": "ETF_CONFIRMATORY_SUBTYPE_CLASSIFICATION_POLICY",
  "policy_version": "1.1.0",
  "effective_spec_version": "1.0.3",
  "spec_commit": "a5efc1777d130c23631986422731b7efd75e4624",
  "created_at": "2026-09-25T18:15:00Z",
  "governance_status": "FROZEN_PRE_EXECUTION",
  "resolution_path": "PATH_C_GOVERNED_PRE_EXECUTION_POLICY_AMENDMENT",
  "amendment_rationale": "Policy v1.0.0 required holding-level single-sector concentration (>=80% in single GICS/ICB sector) which is operationally non-computable from standardized public SEC Form N-PORT filings alone without a proprietary commercial taxonomy license (S&P/MSCI GICS or FTSE ICB). Policy v1.1.0 amends the operational rule to use verifiable SEC Form N-CEN Item C.3.b Index Fund flags, N-PORT portfolio equity/debt breakdowns, constituent holding counts, and registered statutory index/sector mandates, while strictly preserving the five scientific subtypes and 15 preregistered hypotheses without alteration.",
  "scientific_contract_invariants": {
    "confirmatory_subtypes": [
      "EQUITY_INDEX",
      "EQUITY_SECTOR",
      "FIXED_INCOME_GOVERNMENT",
      "FIXED_INCOME_CREDIT",
      "COMMODITY_PHYSICAL"
    ],
    "confirmatory_hypotheses_count": 15,
    "expected_sign_distribution": "11_POSITIVE / 4_NEGATIVE",
    "primary_metric": "CROSS_SECTIONAL_SPEARMAN_RANK_IC",
    "bh_family_size": 15,
    "bh_q_level": 0.05,
    "survivorship_estimand": "CURRENT_ELIGIBLE_UNIVERSE_RETROSPECTIVE_HISTORY",
    "survivorship_bias": "PRESENT_BY_DESIGN",
    "final_inference_engine": "PENDING_COMPLIANT_DATASET_ADEQUACY_AUDIT"
  },
  "positive_certification_restrictions": {
    "heuristic_name_match_can_certify_confirmatory_subtype": false,
    "name_regex_restricted_to_negative_safety_net_only": true,
    "legacy_curated_allowlist_as_sole_authority_prohibited": true,
    "unevaluated_etf_defaults_to_other_etf": false
  },
  "source_hierarchy": [
    {
      "tier": 1,
      "name": "VERIFIED_REGISTRY_SUBTYPE_OVERRIDE",
      "authority": "SEC_FORM_S6_S1_N1A_PROSPECTUS_INSPECTION",
      "description": "Point-in-time verified physical grantor trusts allowlist and verified statutory UIT index allowlists with immutable prospectus provenance."
    },
    {
      "tier": 2,
      "name": "STRUCTURED_REGULATORY_PORTFOLIO_AND_MANDATES",
      "authority": "SEC_EDGAR_FORM_NPORT_AND_NCEN",
      "description": "Quarterly N-PORT portfolio holdings value weights (Treasury, agency, corporate debt, common equity, constituent holding counts) and Form N-CEN Item C.3.b Index Fund flags."
    },
    {
      "tier": 3,
      "name": "STATUTORY_SERIES_INDEX_MANDATE_REGISTRATION",
      "authority": "SEC_FORM_485BPOS_N1A_REGISTRATION_STATEMENT",
      "description": "Series-level principal investment strategy and designated benchmark index mandate filed under the Investment Company Act of 1940."
    },
    {
      "tier": 4,
      "name": "FAIL_CLOSED_UNRESOLVED_SUBTYPE_QUARANTINE",
      "authority": "INSUFFICIENT_SOURCE_EVIDENCE",
      "description": "Instruments lacking authoritative portfolio or mandate evidence remain UNRESOLVED / PENDING_SYSTEMATIC_CLASSIFICATION and are barred from confirmatory candidate pool."
    },
    {
      "tier": 5,
      "name": "EVALUATED_EXPLORATORY_ASSIGNMENT",
      "authority": "AFFIRMATIVE_NON_CONFIRMATORY_EVIDENCE",
      "description": "Instruments affirmatively evaluated and proven to follow non-confirmatory mandates (multi-asset, active equity, covered call, thematic, crypto, leveraged/inverse, mixed aggregate bonds) receive OTHER_ETF / EXPLORATORY_ONLY."
    }
  ],
  "confirmatory_subtype_rules": {
    "EQUITY_INDEX": {
      "required_legal_structures": [
        "1940_ACT_OPEN_END_ETF",
        "1940_ACT_UNIT_INVESTMENT_TRUST_ETF"
      ],
      "required_conditions": [
        "total_equity_pct >= 0.80",
        "is_index_fund == true",
        "distinct_holdings_count >= 30",
        "max_security_concentration < 0.15",
        "is_broad_or_multi_sector_mandate == true"
      ],
      "exclusion_conditions": [
        "total_govt_pct >= 0.20",
        "total_credit_pct >= 0.20",
        "is_sector_specific_mandate == true"
      ],
      "benchmark": "SPY",
      "hypotheses_features": [
        "f1_trend_ratio",
        "f2_relative_strength_60d",
        "f3_rsi_regime_distance"
      ]
    },
    "EQUITY_SECTOR": {
      "required_legal_structures": [
        "1940_ACT_OPEN_END_ETF"
      ],
      "required_conditions": [
        "total_equity_pct >= 0.80",
        "is_sector_specific_mandate == true",
        "designated_sector_in_standard_taxonomy == true"
      ],
      "approved_sectors": [
        "TECHNOLOGY",
        "FINANCIALS",
        "ENERGY",
        "HEALTHCARE",
        "INDUSTRIALS",
        "MATERIALS",
        "CONSUMER_STAPLES",
        "CONSUMER_DISCRETIONARY",
        "UTILITIES",
        "REAL_ESTATE",
        "COMMUNICATION_SERVICES"
      ],
      "exclusion_conditions": [
        "total_equity_pct < 0.80",
        "is_sector_specific_mandate == false"
      ],
      "benchmark": "SPY",
      "hypotheses_features": [
        "f1_trend_ratio",
        "f2_relative_strength_60d",
        "f3_rsi_regime_distance"
      ]
    },
    "FIXED_INCOME_GOVERNMENT": {
      "required_legal_structures": [
        "1940_ACT_OPEN_END_ETF"
      ],
      "required_conditions": [
        "total_govt_pct >= 0.80",
        "corporate_debt_pct < 0.10",
        "mortgage_backed_pct < 0.10",
        "total_equity_pct < 0.05"
      ],
      "exclusion_conditions": [
        "total_govt_pct < 0.80",
        "corporate_debt_pct >= 0.10",
        "mortgage_backed_pct >= 0.10"
      ],
      "qualifying_issuers": [
        "US_TREASURY_BILLS_NOTES_BONDS",
        "US_TREASURY_INFLATION_PROTECTED_SECURITIES_TIPS",
        "US_GOVERNMENT_AGENCIES"
      ],
      "benchmark": "IEF",
      "hypotheses_features": [
        "f1_trend_ratio",
        "f5_yield_curve_slope",
        "f6_rate_momentum_20d"
      ]
    },
    "FIXED_INCOME_CREDIT": {
      "required_legal_structures": [
        "1940_ACT_OPEN_END_ETF"
      ],
      "required_conditions": [
        "corporate_debt_pct >= 0.50",
        "total_govt_pct < 0.50",
        "total_equity_pct < 0.05"
      ],
      "exclusion_conditions": [
        "corporate_debt_pct < 0.50",
        "total_govt_pct >= 0.50",
        "total_equity_pct >= 0.05"
      ],
      "mixed_aggregate_portfolio_policy": "Aggregate bond funds (e.g. AGG, BND, BSV) containing >=50% government/agency debt and <50% corporate credit fail the pure credit threshold and must NOT be classified as FIXED_INCOME_CREDIT unless explicitly covered by a dedicated aggregate bond research subtype.",
      "benchmark": "LQD",
      "hypotheses_features": [
        "f1_trend_ratio",
        "f8_relative_strength_vs_lqd",
        "f12_baa_corporate_spread_trend"
      ]
    },
    "COMMODITY_PHYSICAL": {
      "required_legal_structures": [
        "PHYSICAL_PRECIOUS_METAL_GRANTOR_TRUST"
      ],
      "required_conditions": [
        "legal_structure == 'PHYSICAL_PRECIOUS_METAL_GRANTOR_TRUST'",
        "physical_precious_metal_pct >= 0.90"
      ],
      "exclusion_conditions": [
        "COMMODITY_FUTURES_POOL",
        "EXCHANGE_TRADED_NOTE",
        "derivative_commodity_exposure > 0.05"
      ],
      "benchmark": "BIL",
      "hypotheses_features": [
        "f9_real_yield_regime",
        "f10_dxy_trend",
        "f11_bullion_breakout"
      ]
    }
  },
  "ambiguity_precedence_hierarchy": [
    "COMMODITY_PHYSICAL",
    "FIXED_INCOME_GOVERNMENT",
    "FIXED_INCOME_CREDIT",
    "EQUITY_SECTOR",
    "EQUITY_INDEX",
    "OTHER_ETF"
  ],
  "data_completeness_and_fail_closed_policy": {
    "completeness_flag": "SUBTYPE_EVIDENCE_COMPLETE",
    "insufficient_data_state": {
      "research_subtype": "UNRESOLVED",
      "research_subtype_state": "PENDING_SYSTEMATIC_CLASSIFICATION",
      "subtype_authorized": false,
      "exclusion_reason": "UNRESOLVED_SUBTYPE_PENDING_CLASSIFICATION"
    },
    "default_to_other_prohibited": true
  }
}

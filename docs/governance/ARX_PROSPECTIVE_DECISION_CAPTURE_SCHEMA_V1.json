{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arx.terminal/governance/ARX_PROSPECTIVE_DECISION_CAPTURE_SCHEMA_V1.json",
  "title": "ARX Prospective Full Decision Capture Schema V1.0.1",
  "description": "Canonical schema definitions for prospective, non-interfering passive evidence capture, split denominators, evaluation cycles, and deterministic decision identities.",
  "version": "1.0.1",
  "createdAtUtc": "2026-09-27T21:15:00Z",
  "definitions": {
    "EvidenceOrigin": {
      "type": "string",
      "enum": [
        "NATURAL_PRODUCTION",
        "REPLAY",
        "SIMULATION",
        "TEST"
      ],
      "description": "Operational provenance tier. Only NATURAL_PRODUCTION is permitted to enter the empirical research denominator."
    },
    "ScopeStatus": {
      "type": "string",
      "enum": [
        "IN_SCOPE",
        "INTENTIONALLY_OUT_OF_SCOPE",
        "SCOPE_UNKNOWN"
      ],
      "description": "Universe boundary classification established by governing investment mandates."
    },
    "EvaluationStatus": {
      "type": "string",
      "enum": [
        "COMPLETED",
        "PARTIAL_INFRASTRUCTURE_FAILURE",
        "FAILED_BEFORE_MODEL_EVALUATION",
        "FAILED_DURING_MODEL_EVALUATION",
        "NO_OBSERVED_PRODUCTION_EVALUATION",
        "EVALUATION_STATUS_UNKNOWN"
      ],
      "description": "Operational completion status of an individual asset evaluation."
    },
    "EvaluationCycleType": {
      "type": "string",
      "enum": [
        "SCHEDULED_UNIVERSE_SCAN",
        "RADAR_CYCLE",
        "DISCOVERY_CYCLE",
        "EXPLICIT_USER_REQUEST"
      ],
      "description": "Governed execution trigger establishing expected evaluations."
    },
    "EmpiricalCertificationState": {
      "type": "string",
      "enum": [
        "CERTIFIED_NATURAL_PRODUCTION",
        "UNCERTIFIED_CAPTURE_FAILURE",
        "QUARANTINED_NON_PRODUCTION"
      ],
      "description": "Distinguishes valid research evidence from fail-open uncertified production responses."
    },
    "DecisionState": {
      "type": "string",
      "enum": [
        "DISCOVERY_CANDIDATE",
        "RADAR_SURFACED",
        "ANALYSIS_EVALUATED",
        "SETUP_ELIGIBLE",
        "WAIT",
        "WATCH",
        "REJECT",
        "ACTIONABLE_RECOMMENDATION",
        "TRADE_PLAN_AVAILABLE",
        "EXECUTED_POSITION"
      ],
      "description": "Discrete ARX product-state lifecycle vocabulary."
    },
    "RuleCategory": {
      "type": "string",
      "enum": [
        "MANDATORY_PRODUCT_CONSTRAINT",
        "AUDITED_MODEL_RULE",
        "INFRASTRUCTURE_CONSTRAINT"
      ],
      "description": "Categorization of pipeline decision gates."
    },
    "RuleEvaluationState": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "NOT_EVALUATED_AFTER_BINDING_FAILURE",
        "NOT_APPLICABLE",
        "UNAVAILABLE",
        "ERROR"
      ],
      "description": "Explicit rule evaluation result. Downstream unexecuted rules must never be coded as PASS or FAIL."
    },
    "DataAvailabilityState": {
      "type": "string",
      "enum": [
        "LIVE_AUTHORITATIVE",
        "PROVISIONAL",
        "FALLBACK_AUTHORITY",
        "AUTHENTIC_ZERO",
        "STALE",
        "UNAVAILABLE",
        "ERROR_EMPTY",
        "UNKNOWN"
      ],
      "description": "Explicit data availability semantics preventing coercion of missing values to zero."
    },
    "EvaluationCycle": {
      "type": "object",
      "required": [
        "evaluationCycleId",
        "cycleType",
        "cycleStartTimestampUtc",
        "universeVersion",
        "engineVersion",
        "engineSha",
        "expectedEvaluationsCount",
        "actualEvaluationsCount",
        "missingEvaluationsCount",
        "infrastructureFailuresCount"
      ],
      "properties": {
        "evaluationCycleId": {
          "type": "string",
          "pattern": "^CYC_[A-Z_]+_[0-9]{8}T[0-9]{6}Z_[a-f0-9]{8}$",
          "description": "Immutable cycle identifier: CYC_{cycleType}_{timestampUtc}_{hash8}."
        },
        "cycleType": {
          "$ref": "#/definitions/EvaluationCycleType"
        },
        "cycleStartTimestampUtc": {
          "type": "string",
          "format": "date-time"
        },
        "universeVersion": {
          "type": "string"
        },
        "universeSnapshotId": {
          "type": ["string", "null"],
          "description": "Foreign key to universe snapshot where cycleType != EXPLICIT_USER_REQUEST."
        },
        "engineVersion": {
          "type": "string"
        },
        "engineSha": {
          "type": "string",
          "minLength": 7
        },
        "expectedEvaluationsCount": {
          "type": "integer",
          "minimum": 0
        },
        "actualEvaluationsCount": {
          "type": "integer",
          "minimum": 0
        },
        "missingEvaluationsCount": {
          "type": "integer",
          "minimum": 0
        },
        "infrastructureFailuresCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "ExpectedEvaluationRecord": {
      "type": "object",
      "required": [
        "expectedEvaluationId",
        "evaluationCycleId",
        "symbol",
        "instrumentId",
        "scopeStatus",
        "expectationEstablishedAtUtc",
        "actualEvaluationStatus"
      ],
      "properties": {
        "expectedEvaluationId": {
          "type": "string",
          "description": "Deterministic identifier: EXP_{evaluationCycleId}_{symbol}."
        },
        "evaluationCycleId": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "instrumentId": {
          "type": "string"
        },
        "scopeStatus": {
          "$ref": "#/definitions/ScopeStatus"
        },
        "expectationEstablishedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "actualEvaluationStatus": {
          "$ref": "#/definitions/EvaluationStatus"
        },
        "decisionId": {
          "type": ["string", "null"],
          "description": "Foreign key to DecisionEvent if evaluation completed or partially executed."
        }
      },
      "additionalProperties": false
    },
    "DecisionEvent": {
      "type": "object",
      "required": [
        "decisionId",
        "evaluationCycleId",
        "episodeId",
        "symbol",
        "instrumentId",
        "evaluationTimestampUtc",
        "marketSession",
        "evidenceOrigin",
        "scopeStatus",
        "evaluationStatus",
        "empiricalCertificationState",
        "engineVersion",
        "engineSha",
        "decisionEngineSha",
        "configHash",
        "universeVersion",
        "dataProvider",
        "providerSourceTimestampUtc",
        "ingestionTimestampUtc",
        "freshnessStatus",
        "marketRegime",
        "decisionState",
        "actionabilityState",
        "confluenceScore",
        "rejectionReason",
        "tradePlanState"
      ],
      "properties": {
        "decisionId": {
          "type": "string",
          "pattern": "^DEC_[A-Z0-9._-]+_[a-f0-9]{12}$",
          "description": "Deterministic cryptographic decision identifier: DEC_{symbol}_{sha256(instrumentId+evaluationCycleId+timestamp+engineSha)[:12]}."
        },
        "evaluationCycleId": {
          "type": "string"
        },
        "episodeId": {
          "type": "string",
          "pattern": "^EP_[A-Z0-9._-]+_[0-9]{8}T[0-9]{6}Z_[a-f0-9]{8}$"
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "instrumentId": {
          "type": "string"
        },
        "evaluationTimestampUtc": {
          "type": "string",
          "format": "date-time"
        },
        "marketSession": {
          "type": "string",
          "enum": ["PRE_MARKET", "REGULAR_SESSION", "POST_MARKET", "WEEKEND_CLOSED"]
        },
        "evidenceOrigin": {
          "$ref": "#/definitions/EvidenceOrigin"
        },
        "scopeStatus": {
          "$ref": "#/definitions/ScopeStatus"
        },
        "evaluationStatus": {
          "$ref": "#/definitions/EvaluationStatus"
        },
        "empiricalCertificationState": {
          "$ref": "#/definitions/EmpiricalCertificationState"
        },
        "engineVersion": {
          "type": "string"
        },
        "engineSha": {
          "type": "string",
          "minLength": 7
        },
        "decisionEngineSha": {
          "type": "string",
          "minLength": 7
        },
        "configHash": {
          "type": "string",
          "minLength": 64
        },
        "universeVersion": {
          "type": "string"
        },
        "universeSnapshotId": {
          "type": ["string", "null"]
        },
        "dataProvider": {
          "type": "string"
        },
        "providerSourceTimestampUtc": {
          "type": "string",
          "format": "date-time"
        },
        "ingestionTimestampUtc": {
          "type": "string",
          "format": "date-time"
        },
        "freshnessStatus": {
          "$ref": "#/definitions/DataAvailabilityState"
        },
        "marketRegime": {
          "type": "string",
          "enum": ["BULL", "BEAR", "SIDEWAYS", "HIGH_VOLATILITY", "UNKNOWN"]
        },
        "decisionState": {
          "$ref": "#/definitions/DecisionState"
        },
        "actionabilityState": {
          "type": "string",
          "enum": ["ACTIONABLE", "NON_ACTIONABLE", "SUPPRESSED", "DEGRADED"]
        },
        "confluenceScore": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "maximum": 100.0
        },
        "crossSectionalRank": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "crossSectionalPopulationSize": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "rejectionReason": {
          "$ref": "#/definitions/StructuredRejectionReason"
        },
        "tradePlanState": {
          "$ref": "#/definitions/TradePlanState"
        },
        "infrastructureFailure": {
          "$ref": "#/definitions/InfrastructureFailure"
        }
      },
      "additionalProperties": false
    },
    "StructuredRejectionReason": {
      "type": "object",
      "required": [
        "isRejected",
        "firstBindingRuleId",
        "firstBindingRuleCategory",
        "primaryReasonText",
        "allExecutedFailedRuleIds"
      ],
      "properties": {
        "isRejected": {
          "type": "boolean"
        },
        "firstBindingRuleId": {
          "type": ["string", "null"]
        },
        "firstBindingRuleCategory": {
          "type": ["string", "null"],
          "enum": [
            "MANDATORY_PRODUCT_CONSTRAINT",
            "AUDITED_MODEL_RULE",
            "INFRASTRUCTURE_CONSTRAINT",
            null
          ]
        },
        "primaryReasonText": {
          "type": "string"
        },
        "allExecutedFailedRuleIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Rules that actually executed and failed; does not include unexecuted downstream rules."
        },
        "infrastructureFailure": {
          "$ref": "#/definitions/InfrastructureFailure"
        }
      },
      "additionalProperties": false
    },
    "TradePlanState": {
      "type": ["object", "null"],
      "properties": {
        "isPlanGenerated": {
          "type": "boolean"
        },
        "entryReferencePrice": {
          "type": ["number", "null"]
        },
        "corridorMin": {
          "type": ["number", "null"]
        },
        "corridorMax": {
          "type": ["number", "null"]
        },
        "stopLoss": {
          "type": ["number", "null"]
        },
        "takeProfit1": {
          "type": ["number", "null"]
        },
        "takeProfit2": {
          "type": ["number", "null"]
        },
        "riskRewardRatio": {
          "type": ["number", "null"]
        },
        "counterfactualEvaluationEligible": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "FeatureSnapshot": {
      "type": "object",
      "required": [
        "decisionId",
        "featureSnapshotHash",
        "timestampUtc",
        "features"
      ],
      "properties": {
        "decisionId": {
          "type": "string"
        },
        "featureSnapshotHash": {
          "type": "string",
          "minLength": 64
        },
        "timestampUtc": {
          "type": "string",
          "format": "date-time"
        },
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "featureName",
              "featureValue",
              "source",
              "sourceTimestampUtc",
              "observedAtUtc",
              "availabilityStatus",
              "version"
            ],
            "properties": {
              "featureName": {
                "type": "string"
              },
              "featureValue": {
                "type": ["number", "string", "boolean", "null"]
              },
              "source": {
                "type": "string"
              },
              "sourceTimestampUtc": {
                "type": "string",
                "format": "date-time"
              },
              "observedAtUtc": {
                "type": "string",
                "format": "date-time"
              },
              "availabilityStatus": {
                "$ref": "#/definitions/DataAvailabilityState"
              },
              "version": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "RuleEvaluation": {
      "type": "object",
      "required": [
        "decisionId",
        "ruleId",
        "ruleVersion",
        "ruleCategory",
        "actualExecutionOrder",
        "evaluationState",
        "inputValues",
        "thresholdValue",
        "isBinding"
      ],
      "properties": {
        "decisionId": {
          "type": "string"
        },
        "ruleId": {
          "type": "string"
        },
        "ruleVersion": {
          "type": "string"
        },
        "ruleCategory": {
          "$ref": "#/definitions/RuleCategory"
        },
        "actualExecutionOrder": {
          "type": "integer",
          "minimum": 1,
          "description": "Chronological order in which the rule actually executed in runtime."
        },
        "evaluationState": {
          "$ref": "#/definitions/RuleEvaluationState"
        },
        "inputValues": {
          "type": "object"
        },
        "thresholdValue": {
          "type": ["number", "string", "boolean", "null"]
        },
        "isBinding": {
          "type": "boolean"
        },
        "failureMessage": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "UniverseSnapshot": {
      "type": "object",
      "required": [
        "universeSnapshotId",
        "snapshotTimestampUtc",
        "universeVersion",
        "membershipSource",
        "membershipSha256",
        "totalInScopeCount",
        "totalEvaluatedCount",
        "exclusionCountsByCategory"
      ],
      "properties": {
        "universeSnapshotId": {
          "type": "string"
        },
        "snapshotTimestampUtc": {
          "type": "string",
          "format": "date-time"
        },
        "universeVersion": {
          "type": "string"
        },
        "membershipSource": {
          "type": "string"
        },
        "membershipSha256": {
          "type": "string",
          "minLength": 64
        },
        "totalInScopeCount": {
          "type": "integer",
          "minimum": 0
        },
        "totalEvaluatedCount": {
          "type": "integer",
          "minimum": 0
        },
        "exclusionCountsByCategory": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "includedSymbols": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "InfrastructureFailure": {
      "type": ["object", "null"],
      "properties": {
        "isInfrastructureFailure": {
          "type": "boolean"
        },
        "failureType": {
          "type": "string",
          "enum": [
            "PROVIDER_UNAVAILABLE",
            "STALE_QUOTE",
            "MISSING_FUNDAMENTALS",
            "UNIVERSE_INGESTION_FAILURE",
            "PIPELINE_TIMEOUT",
            "SERIALIZATION_FAILURE",
            "UNHANDLED_EXCEPTION",
            "NETWORK_TIMEOUT"
          ]
        },
        "provider": {
          "type": "string"
        },
        "errorMessage": {
          "type": "string"
        },
        "occurredAtUtc": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "Episode": {
      "type": "object",
      "required": [
        "episodeId",
        "symbol",
        "episodeStartUtc",
        "episodeStatus",
        "sessionsObservedCount",
        "decisionIds"
      ],
      "properties": {
        "episodeId": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "episodeStartUtc": {
          "type": "string",
          "format": "date-time"
        },
        "episodeLastEvaluatedUtc": {
          "type": "string",
          "format": "date-time"
        },
        "episodeStatus": {
          "type": "string",
          "enum": [
            "ACTIVE_CONTINUATION",
            "RESET_PRICE_LEVEL_ALTERED",
            "TERMINATED_ENTRY_EXPIRED",
            "TERMINATED_STOP_INVALIDATED",
            "TERMINATED_TRADE_RESOLVED"
          ]
        },
        "sessionsObservedCount": {
          "type": "integer",
          "minimum": 1
        },
        "initialTradePlanHash": {
          "type": "string"
        },
        "decisionIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "OutcomeLink": {
      "type": "object",
      "required": [
        "outcomeLinkId",
        "decisionId",
        "episodeId",
        "governingContractId",
        "governingContractVersion",
        "governingContractSha256",
        "outcomeStatus",
        "recordedAtUtc"
      ],
      "properties": {
        "outcomeLinkId": {
          "type": "string"
        },
        "decisionId": {
          "type": "string"
        },
        "episodeId": {
          "type": "string"
        },
        "tradePlanId": {
          "type": ["string", "null"]
        },
        "governingContractId": {
          "type": "string"
        },
        "governingContractVersion": {
          "type": "string"
        },
        "governingContractSha256": {
          "type": "string",
          "minLength": 64
        },
        "outcomeStatus": {
          "type": "string",
          "enum": [
            "PENDING_UNMATURED",
            "SUCCESS",
            "FAILURE",
            "NEUTRAL",
            "ENTRY_NOT_TRIGGERED",
            "UNRESOLVED_INTRABAR_SEQUENCE",
            "UNRESOLVED_DATA_CONFLICT",
            "OUTCOME_DATA_MISSING"
          ]
        },
        "realizedGrossReturnPct": {
          "type": ["number", "null"]
        },
        "realizedNetSimulatedReturnPct": {
          "type": ["number", "null"]
        },
        "realizedRMultiple": {
          "type": ["number", "null"]
        },
        "recordedAtUtc": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "DecisionCorrectionEvent": {
      "type": "object",
      "required": [
        "correctionEventId",
        "originalDecisionId",
        "correctedFieldName",
        "originalValue",
        "correctedValue",
        "correctionReason",
        "authorizedBy",
        "timestampUtc"
      ],
      "properties": {
        "correctionEventId": {
          "type": "string",
          "pattern": "^COR_[A-Z0-9._-]+_[a-f0-9]{8}$"
        },
        "originalDecisionId": {
          "type": "string"
        },
        "correctedFieldName": {
          "type": "string"
        },
        "originalValue": {
          "type": ["string", "number", "boolean", "null", "object", "array"]
        },
        "correctedValue": {
          "type": ["string", "number", "boolean", "null", "object", "array"]
        },
        "correctionReason": {
          "type": "string"
        },
        "authorizedBy": {
          "type": "string"
        },
        "timestampUtc": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  }
}

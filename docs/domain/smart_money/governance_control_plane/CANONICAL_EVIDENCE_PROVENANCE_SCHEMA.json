{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CanonicalEvidenceProvenanceSchema",
  "description": "Normative schema for governance evidence provenance, preventing synthetic/fixture contamination in canonical snapshots.",
  "type": "object",
  "required": [
    "evidence_id",
    "source_uri_or_path",
    "source_type",
    "source_authority",
    "source_version",
    "content_hash",
    "synthetic",
    "fixture",
    "test_persona",
    "authoritative_for_gate",
    "observed_at",
    "current",
    "recomputation_status"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "pattern": "^urn:arx:evidence:[a-z0-9_-]+:[a-z0-9_-]+$"
    },
    "source_uri_or_path": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "GIT_COMMIT",
        "CRYPTOGRAPHIC_MANIFEST",
        "AUDIT_REPORT",
        "WORM_STORAGE_RECEIPT",
        "RFC3161_TIMESTAMP_TOKEN",
        "OIDC_SIGNATURE_BUNDLE",
        "LOCAL_VERIFICATION_ASSERTION"
      ]
    },
    "source_authority": {
      "type": "string",
      "pattern": "^urn:arx:(authority|identity):[a-z0-9_-]+:v[0-9]+$"
    },
    "source_version": {
      "type": "string"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "synthetic": {
      "type": "boolean",
      "description": "Must be false for canonical authority inputs."
    },
    "fixture": {
      "type": "boolean",
      "description": "Must be false for canonical authority inputs."
    },
    "test_persona": {
      "type": "boolean",
      "description": "Must be false for canonical authority inputs."
    },
    "authoritative_for_gate": {
      "type": "boolean",
      "description": "Must be true for canonical authority inputs."
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "current": {
      "type": "boolean"
    },
    "recomputation_status": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "UNVERIFIED",
        "NOT_RECOMPUTABLE",
        "STALE"
      ]
    }
  },
  "additionalProperties": false
}

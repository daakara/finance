{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GovernancePolicyRatificationCertificate",
  "type": "object",
  "required": [
    "ratification_id",
    "artifact_type",
    "artifact_hash",
    "policy_or_schema_version",
    "governance_epoch",
    "approver_identities",
    "required_quorum",
    "actual_quorum",
    "approval_evidence",
    "ratified_sequence",
    "ratified_at",
    "supersedes",
    "ratification_hash"
  ],
  "properties": {
    "ratification_id": {
      "type": "string",
      "pattern": "^urn:arx:ratification:[a-z0-9\\-_:]+$"
    },
    "artifact_type": {
      "type": "string",
      "enum": ["POLICY", "FINDING_SCHEMA", "POLICY_SCHEMA", "DECISION_ENGINE"]
    },
    "artifact_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_or_schema_version": {
      "type": "string"
    },
    "governance_epoch": {
      "type": "string",
      "pattern": "^epoch-gov-[0-9]{3}$"
    },
    "approver_identities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^urn:arx:identity:[a-z0-9\\-_:]+$"
      }
    },
    "required_quorum": {
      "type": "integer",
      "minimum": 1
    },
    "actual_quorum": {
      "type": "integer",
      "minimum": 1
    },
    "approval_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["approver", "key_id", "signature", "signed_at"],
        "properties": {
          "approver": { "type": "string" },
          "key_id": { "type": "string" },
          "signature": { "type": "string" },
          "signed_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "ratified_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "ratified_at": {
      "type": "string",
      "format": "date-time"
    },
    "supersedes": {
      "type": ["string", "null"]
    },
    "ratification_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GovernanceEvidenceInventory",
  "type": "object",
  "required": [
    "inventory_id",
    "governance_epoch",
    "required_source_classes",
    "expected_artifacts",
    "observed_artifacts",
    "missing_artifacts",
    "revoked_artifacts",
    "stale_artifacts",
    "zero_finding_attestations",
    "evidence_set_complete",
    "missing_required_evidence_refs",
    "unreconciled_required_evidence",
    "inventory_hash"
  ],
  "properties": {
    "inventory_id": {
      "type": "string",
      "pattern": "^urn:arx:inventory:evidence:[a-z0-9\\-_:]+$"
    },
    "governance_epoch": {
      "type": "string",
      "pattern": "^epoch-gov-[0-9]{3}$"
    },
    "required_source_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "expected_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "source_class", "expected_hash"],
        "properties": {
          "artifact_id": { "type": "string" },
          "source_class": { "type": "string" },
          "expected_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "observed_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "source_class", "observed_hash", "verified_at"],
        "properties": {
          "artifact_id": { "type": "string" },
          "source_class": { "type": "string" },
          "observed_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "verified_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "missing_artifacts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "revoked_artifacts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "stale_artifacts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "zero_finding_attestations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "audit_id",
          "evidence_hash",
          "reviewer",
          "policy_version",
          "timestamp_utc"
        ],
        "properties": {
          "audit_id": { "type": "string" },
          "evidence_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "reviewer": { "type": "string", "pattern": "^urn:arx:identity:[a-z0-9\\-_:]+$" },
          "policy_version": { "type": "string" },
          "timestamp_utc": { "type": "string", "format": "date-time" }
        }
      }
    },
    "evidence_set_complete": {
      "type": "boolean"
    },
    "missing_required_evidence_refs": {
      "type": "integer",
      "minimum": 0
    },
    "unreconciled_required_evidence": {
      "type": "integer",
      "minimum": 0
    },
    "inventory_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}

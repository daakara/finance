    { "id": 3, "action": "RATIFY_BOOTSTRAP_AUTHORIZATION", "requires": [2] },
    { "id": 4, "action": "PROVISION_AUTHORITATIVE_GOVERNANCE_LEDGER", "requires": [3] },
    { "id": 5, "action": "PROVISION_INDEPENDENT_WITNESS", "requires": [4] },
    { "id": 6, "action": "VERIFY_LEDGER_AND_WITNESS_CONFIGURATION", "requires": [5] },
    { "id": 7, "action": "RATIFY_GENESIS_POLICY_HASH", "requires": [6] },
    { "id": 8, "action": "PUBLISH_GENESIS_MANIFEST", "requires": [7] },
    { "id": 9, "action": "APPEND_GENESIS_LEDGER_EVENT", "requires": [8] },
    { "id": 10, "action": "OBTAIN_GENESIS_WITNESS_PROOF", "requires": [9] },
    { "id": 11, "action": "VERIFY_GENESIS_CHAIN", "requires": [10] },

    "WITNESS_SUCCEEDED_LOCAL_RESPONSE_LOST": { "action": "RESUME", "retryable": true },
    "ROOT_MEMBER_REVOKED_MID_CEREMONY": { "action": "ROLLBACK_NON_AUTHORITATIVE_PREPARATION", "retryable": false },
    "BOOTSTRAP_EXPIRED_MID_CEREMONY": { "action": "TERMINAL_HOLD", "retryable": false }
  },
  "invariants": {
    "strict_ordering_required": true,
    "skipped_step_allowed": false,
    "duplicate_genesis_allowed": false,
    "ambiguous_failure_state_allowed": false,
    "normal_authority_requires_extinguishment": true
  }

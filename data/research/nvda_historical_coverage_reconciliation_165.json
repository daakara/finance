  "corrections_and_superseded_claims": {
    "catalog_completeness_reconciliation": {
      "previous_claim": "Preliminary report stated catalog could not prove absence of Form 4s through Nov 19 because latest Form 4 was Nov 06.",
      "corrected_finding": "An authoritative, validated SEC submissions catalog is technically capable of supporting the absence of Form 4 filings within any interval it contiguously spans (establishing technical evidence, not a legal opinion). For [2026-08-26, 2026-11-19T21:45:59Z], the catalog contiguously covers the interval, and all 15 in-window Form 4/A accessions are fully accounted for. However, for the full trial operational interval [2026-08-26, 2026-11-24], the catalog fails the governing validation requirement (validate_submissions_catalog_evidence Section 8) because it was acquired on 2026-11-22T08:53:12Z (latest filing: 2026-11-19T21:45:59Z), which is prior to the trial end date and prior to forward filing 0001696841-26-000016 (accepted 2026-11-23T21:54:28Z)."
    },
    "aapl_count_discrepancy_reconciliation": {
      "previous_claim": "Report previously stated 38 AAPL filings and 104 AAPL transactions by subtracting NVDA from total database rows (55 - 17 = 38; 152 - 48 = 104).",
      "corrected_finding": "Subtraction error corrected by grouping live database storage by actual issuer CIK and ticker. AAPL has exactly 6 raw filings and 18 parsed transactions in the database (100% agreement with earlier audits). The remaining 32 filings and 86 transactions belong to 11 other historical governed issuers (GOOGL: 4/29, TSLA: 4/14, META: 4/12, MSFT: 4/7, V: 3/9, BRK-B: 3/5, AMZN: 4/4, JPM: 3/3, ACLS: 1/1, LLY: 1/1, VRTX: 1/1)."
    },
    "sale_terminology_correction": {
      "previous_claim": "Code S was labeled broadly as \"open-market sale\" based on trading plan and pricing footnotes.",
      "corrected_finding": "Code S is strictly labeled as \"Sale\" per SEC Form 4 official specification. Rule 10b5-1 plan status and weighted-average pricing are tracked as distinct transaction attributes. The phrase \"open-market sale\" is suppressed because zero filings explicitly state an open-market execution venue in their narrative text."
    }
  },
